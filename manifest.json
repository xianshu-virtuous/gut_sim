    "plugins": [],
    "components": []
  },
  "include": [
    {
      "component_type": "event_handler",
      "component_name": "gut_sim_received",
      "dependencies": [],
      "enabled": true
    },
    {
      "component_type": "event_handler",
      "component_name": "gut_sim_usage",
      "dependencies": [],
      "enabled": true
    },
    {
      "component_type": "event_handler",
